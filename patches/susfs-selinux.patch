+{
+	if ((likely(!strcmp(name, "current") &&
+				current_uid().val >= 10000 &&
+				ksu_selinux_hide_running)))
+		return susfs_selinux_setprocattr(name, value, size);
+	return selinux_setprocattr(name, value, size);
+}
